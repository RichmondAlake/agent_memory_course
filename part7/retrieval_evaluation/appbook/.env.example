# Copy to .env (or put the same values in ../.env or part7/.env). Process environment variables always win.
# The retrieval benchmark appbook needs no API key: it reads the notebook's stored run from Oracle and embeds or
# reranks single queries with local models.

# Oracle AI Database (start it with ./oracle.sh start in part7/).
ORACLE_USER=VECTOR
ORACLE_PASSWORD=VectorPwd_2025
ORACLE_DSN=localhost:1521/FREEPDB1

# The run to open first (default: the latest run in BEIR7_RUNS that has test results).
# BEIR7APP_RUN_ID=beir7-20261022-114416-ef2eb0

# Optional tracing to Arize AX: the query explorer's embedding, retrievals and reranker. Off unless both are set.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# ARIZE_PROJECT_NAME=beir-retrieval-benchmark-appbook
