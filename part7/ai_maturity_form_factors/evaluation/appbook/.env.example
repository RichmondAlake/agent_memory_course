# Copy to .env (or put the same values in ../.env, ../../.env or part7/.env). Process environment variables always
# win. Never commit the .env file.

# The application under test: Claude Haiku 5.5 with an Anthropic key. Leave it empty (or set AIML_PROVIDER=ollama)
# to run the application, its agents and the judge on Gemma 4 through Ollama instead (no key, no API cost).
ANTHROPIC_API_KEY=sk-ant-...
AIML_MODEL=claude-haiku-5-5
AIML_EFFORT=low
# AIML_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# AIML_OPEN_MODEL=gemma4

# The LLM judge, from another model family: gpt-6.1-sol when OPENAI_API_KEY is set, otherwise claude-sonnet-5-5.
OPENAI_API_KEY=
# EVAL_JUDGE_MODEL=gpt-6.1-sol

# Jev, TypeSafe's hosted decision model (optional; without it the graders are Clef-Flash and the judge).
TYPESAFE_API_KEY=

# Clef-Flash runs in this process on Apple silicon (MLX, about 7 GB). Elsewhere, or to share one copy between apps,
# point CLEF_URL at a SystemOne endpoint serving Clef.
# CLEF_URL=http://127.0.0.1:8790

# Oracle AI Database (start it with ./oracle.sh start in part7/).
ORACLE_USER=VECTOR
ORACLE_PASSWORD=VectorPwd_2025
ORACLE_DSN=localhost:1521/FREEPDB1

# Optional: trace every model, agent, grader and retrieval call to Arize AX (on when both are set).
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# ARIZE_PROJECT_NAME=ai-maturity-evaluation-appbook
