# Copy to .env (or put the same values in ../.env or part7/.env). Process
# environment variables always win. Set ANTHROPIC_API_KEY for Claude, or leave it
# empty to run every model call on Gemma 4 through Ollama (no key, no API cost).

ANTHROPIC_API_KEY=sk-ant-...

# Open models: Gemma 4 on this machine through Ollama (install it from ollama.com and start it).
# Used when AIML_PROVIDER=ollama or ANTHROPIC_API_KEY is empty. The app pulls the model on first start.
# AIML_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# AIML_OPEN_MODEL=gemma4        # Gemma 4 E4B (about 10 GB); gemma4:12b or gemma4:26b with more memory

# Model used across all five form factors: Claude Haiku 5.5, the latest and lowest-cost Claude model.
# It thinks before answering; AIML_EFFORT keeps that short.
AIML_MODEL=claude-haiku-5-5
AIML_MAX_TOKENS=2048
AIML_EFFORT=low

# Embedding model (torch-free, via fastembed). Matches the notebook.
AIML_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# The Clef-Flash decision model (Form Factors 3 and 4) runs in-process on Apple silicon (MLX).
# On other machines, point CLEF_URL at a SystemOne endpoint instead.
# CLEF_URL=http://localhost:8000

# Oracle AI Database (required; start it with part7/oracle.sh from the part7 folder).
ORACLE_USER=VECTOR
ORACLE_PASSWORD=VectorPwd_2025
ORACLE_DSN=localhost:1521/FREEPDB1

# Optional: trace every model, agent, retrieval and reranker call to Arize AX (on when both are set).
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# ARIZE_PROJECT_NAME=ai-maturity-form-factors-appbook
