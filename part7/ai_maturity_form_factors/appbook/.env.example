# Copy to .env (or put the same values in ../.env or part7/.env). Process
# environment variables always win. Only ANTHROPIC_API_KEY is required.

ANTHROPIC_API_KEY=sk-ant-...

# Model used across all five form factors: Claude Haiku 5.5, the latest and lowest-cost Claude model.
# It thinks before answering; AIML_EFFORT keeps that short.
AIML_MODEL=claude-haiku-5-5
AIML_MAX_TOKENS=2048
AIML_EFFORT=low

# Embedding model (torch-free, via fastembed). Matches the notebook.
AIML_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# The Clef-Flash decision model (Form Factors 3 and 4) runs in-process on Apple silicon (MLX).
# On other machines, point CLEF_URL at a SystemOne endpoint instead.
# CLEF_URL=http://localhost:8000

# Oracle AI Database (required; start it with part7/oracle.sh from the part7 folder).
ORACLE_USER=VECTOR
ORACLE_PASSWORD=VectorPwd_2025
ORACLE_DSN=localhost:1521/FREEPDB1
