# Copy to .env (or put the same values in ../.env, ../../.env or part7/.env). Process environment variables always
# win. Never commit the .env file.

# The agents under test: gpt-6.1-sol answers, gpt-6-luna does background work, text-embedding-3-small at 256
# dimensions. Leave OPENAI_API_KEY empty (or set MEMO_PROVIDER=ollama) to run the agents, the embeddings and the judge
# on Gemma 4 and nomic-embed-text through Ollama instead (no key, no API cost).
OPENAI_API_KEY=
# MEMO_MODEL=gpt-6.1-sol
# MEMO_CHEAP_MODEL=gpt-6-luna
# MEMO_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# MEMO_OPEN_MODEL=gemma4

# The LLM judge, from another model family: claude-sonnet-5-5 when ANTHROPIC_API_KEY is set, otherwise gpt-6.1-sol.
ANTHROPIC_API_KEY=
# MEMO_EVAL_JUDGE_MODEL=claude-sonnet-5-5

# Jev, TypeSafe's hosted decision model (optional; without it the graders are Clef-Flash and the judge).
TYPESAFE_API_KEY=

# Clef-Flash runs in this process on Apple silicon (MLX, about 7 GB). Elsewhere, or to share one copy between apps,
# point CLEF_URL at a SystemOne endpoint serving Clef.
# CLEF_URL=http://127.0.0.1:8790

# A run keeps what it wrote, so its MemoRizz traces appear in the MemoRizz UI (Traces, filtered by agent); set
# MEMO_CLEANUP=1 to delete this run's rows.
# MEMO_CLEANUP=1

# Optional: trace every model call, grader verdict and Oracle recall to Arize AX (off unless both are set).
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# ARIZE_PROJECT_NAME=agent-memory-evaluation-appbook

# Every model call fails after this many seconds instead of hanging a run.
# MEMEVAL_TIMEOUT=180

# Oracle AI Database (start it with ./oracle.sh start in part7/): the MEMORIZZ schema.
ORACLE_USER=MEMORIZZ
ORACLE_PASSWORD=MemorizzPwd_2026
ORACLE_DSN=localhost:1521/FREEPDB1
