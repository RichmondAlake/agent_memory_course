# Copy to .env (ignored by git). Process variables always win over this file.

# OpenAI: the reasoning model and 256-d embeddings for both agents.
# No key? Leave it empty (or set MEMO_PROVIDER=ollama) and both agents run on open models on this machine:
# Gemma 4 and nomic-embed-text through Ollama (install it from ollama.com). The models are pulled on first start.
OPENAI_API_KEY=sk-...

# Open models through Ollama (used when MEMO_PROVIDER=ollama or OPENAI_API_KEY is empty).
# MEMO_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# MEMO_OPEN_MODEL=gemma4          # Gemma 4 E4B (about 10 GB); gemma4:12b or gemma4:26b with more memory

# Optional: TypeSafe Jev, the decision model on the Part 15 routing page.
TYPESAFE_API_KEY=

# Model used by both agents (Responses API, reasoning effort "none").
MEMO_MODEL=gpt-5.5

# The LLM judge that grades golden answers on the Tokenomics page (low reasoning effort).
# Prefer a different model family from the agents' when one is available.
MEMO_JUDGE_MODEL=gpt-5.5

# Optional: trace every model call and memory-unit read to Arize AX (off unless both are set).
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# ARIZE_PROJECT_NAME=agent-memory-zero-to-hero-appbook

# Oracle AI Database: the MEMORIZZ schema provisioned by part7/oracle.sh.
# There is no fallback store; the app reports a clear error when it is down.
ORACLE_USER=MEMORIZZ
ORACLE_PASSWORD=MemorizzPwd_2026
ORACLE_DSN=localhost:1521/FREEPDB1

# A session keeps what it wrote, so its MemoRizz traces appear in the MemoRizz UI. Set 1 to delete a session's
# rows on reset, on shutdown and after a Tokenomics run.
MEMO_CLEANUP=0
