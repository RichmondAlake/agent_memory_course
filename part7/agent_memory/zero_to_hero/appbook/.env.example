# Copy to .env (ignored by git). Process variables always win over this file.

# Required: OpenAI reasoning model and 256-d embeddings for both agents.
OPENAI_API_KEY=sk-...

# Optional: TypeSafe Jev, the decision model on the Part 15 routing page.
TYPESAFE_API_KEY=

# Model used by both agents (Responses API, reasoning effort "none").
MEMO_MODEL=gpt-5.5

# The LLM judge that grades golden answers on the Tokenomics page (low reasoning effort).
# Prefer a different model family from the agents' when one is available.
MEMO_JUDGE_MODEL=gpt-5.5

# Oracle AI Database: the MEMORIZZ schema provisioned by part7/oracle.sh.
# There is no fallback store; the app reports a clear error when it is down.
ORACLE_USER=MEMORIZZ
ORACLE_PASSWORD=MemorizzPwd_2026
ORACLE_DSN=localhost:1521/FREEPDB1

# Delete the lab session's rows on reset and on shutdown (1) or keep them (0).
MEMO_CLEANUP_ON_RESET=1
